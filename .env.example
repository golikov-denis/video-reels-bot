# Токен бота из @BotFather. Никогда не публикуйте настоящее значение.
TELEGRAM_BOT_TOKEN=

# Отдельная случайная строка: A-Z, a-z, 0-9, "_" и "-", до 256 символов.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Публичный HTTPS-адрес production deployment без завершающего "/".
APP_URL=https://your-project.vercel.app
