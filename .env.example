# Токен бота из @BotFather. Никогда не публикуйте настоящее значение.
TELEGRAM_BOT_TOKEN=

# Отдельная случайная строка: A-Z, a-z, 0-9, "_" и "-", до 256 символов.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Публичный HTTPS-адрес приложения без завершающего "/".
APP_URL=https://your-project.vercel.app

# Строки подключения Neon. Настоящие значения не коммитить.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# S3-совместимое приватное хранилище Backblaze B2.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003
S3_BUCKET=
